# Google Gemini API key (for Gemini 2.5 Flash / image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API key (for real-time web research)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: PostgreSQL Database URL for LangGraph checkpointer persistence
# If not provided or unreachable, AgentPress automatically falls back to MemorySaver
DATABASE_URL=

