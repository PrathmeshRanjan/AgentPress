# Google Gemini API key (for Gemini 2.5 Flash chat & multimodal image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API key (optional: if you want to use Mistral Small for chat generation)
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily Search API key (for real-time web research)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Override the chat LLM model
# MODEL_NAME=mistralai:mistral-small-latest
# or MODEL_NAME=google_genai:gemini-2.5-flash
